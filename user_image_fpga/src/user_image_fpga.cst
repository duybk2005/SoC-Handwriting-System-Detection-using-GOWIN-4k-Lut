// Tang Nano 4K (GW1NSR-4C QN48P)
// Chân camera và HDMI lấy theo project "cam hdmi" (dk_video.cst) và "image" (project.cst)

// ---- Clock 27 MHz + LED ----
IO_LOC "clk_27m" 45;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led" 10;
IO_PORT "led" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// ---- Camera OV2640 ----
IO_LOC "cam_xclk" 33;
IO_PORT "cam_xclk" IO_TYPE=LVCMOS25 PULL_MODE=NONE DRIVE=8;
IO_LOC "cam_scl" 44;
IO_PORT "cam_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "cam_sda" 46;
IO_PORT "cam_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "cam_pclk" 41;
IO_PORT "cam_pclk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "cam_vsync" 43;
IO_PORT "cam_vsync" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "cam_href" 42;
IO_PORT "cam_href" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "cam_data[9]" 40;
IO_PORT "cam_data[9]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "cam_data[8]" 39;
IO_PORT "cam_data[8]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "cam_data[7]" 23;
IO_PORT "cam_data[7]" PULL_MODE=UP;
IO_LOC "cam_data[6]" 16;
IO_PORT "cam_data[6]" PULL_MODE=UP;
IO_LOC "cam_data[5]" 18;
IO_PORT "cam_data[5]" PULL_MODE=UP;
IO_LOC "cam_data[4]" 20;
IO_PORT "cam_data[4]" PULL_MODE=UP;
IO_LOC "cam_data[3]" 19;
IO_PORT "cam_data[3]" PULL_MODE=UP;
IO_LOC "cam_data[2]" 17;
IO_PORT "cam_data[2]" PULL_MODE=UP;
IO_LOC "cam_data[1]" 21;
IO_PORT "cam_data[1]" PULL_MODE=UP;
IO_LOC "cam_data[0]" 22;
IO_PORT "cam_data[0]" PULL_MODE=UP;

// ---- HDMI TMDS ----
// Bank 2 dùng chung với cam_xclk (LVCMOS25) -> VCCIO 2.5V, nên TMDS phải là LVDS25E
IO_LOC "tmds_clk_p" 28,27;
IO_PORT "tmds_clk_p" IO_TYPE=LVDS25E PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[0]" 30,29;
IO_PORT "tmds_d_p[0]" IO_TYPE=LVDS25E PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[1]" 32,31;
IO_PORT "tmds_d_p[1]" IO_TYPE=LVDS25E PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[2]" 35,34;
IO_PORT "tmds_d_p[2]" IO_TYPE=LVDS25E PULL_MODE=NONE DRIVE=8;
