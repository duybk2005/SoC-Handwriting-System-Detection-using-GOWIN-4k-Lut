        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    START([\&quot;Bắt đầu\&quot;])\n    INPUT[/\&quot;Nhận ảnh grayscale 28×28&lt;br/&gt;UINT8, giá trị 0..255\&quot;/]\n    PAD[\&quot;Thêm viền 0 rộng 2 pixel mỗi cạnh&lt;br/&gt;Đầu ra: 1×32×32, UINT8\&quot;]\n\n    C1[\&quot;C1: Conv 5×5, 1→6 kênh + bias&lt;br/&gt;Đầu ra: 6×28×28, INT32\&quot;]\n    R1[\&quot;ReLU → Requant → Clip 0..127&lt;br/&gt;Đầu ra: 6×28×28, INT8\&quot;]\n    S2[\&quot;S2: MaxPool 2×2, stride 2&lt;br/&gt;Đầu ra: 6×14×14, INT8\&quot;]\n\n    C3[\&quot;C3: Conv 5×5, 6→16 kênh + bias&lt;br/&gt;Kết nối đầy đủ&lt;br/&gt;Đầu ra: 16×10×10, INT32\&quot;]\n    R3[\&quot;ReLU → Requant → Clip 0..127&lt;br/&gt;Đầu ra: 16×10×10, INT8\&quot;]\n    S4[\&quot;S4: MaxPool 2×2, stride 2&lt;br/&gt;Đầu ra: 16×5×5, INT8\&quot;]\n\n    C5[\&quot;C5: Conv 5×5, 16→120 kênh + bias&lt;br/&gt;Đầu ra: 120×1×1, INT32\&quot;]\n    R5[\&quot;ReLU → Requant → Clip 0..127&lt;br/&gt;Đầu ra: 120×1×1, INT8\&quot;]\n    FLAT[\&quot;Flatten&lt;br/&gt;Vector 120 phần tử, INT8\&quot;]\n\n    F6[\&quot;F6: Linear 120→84 + bias&lt;br/&gt;Đầu ra: 84 phần tử, INT32\&quot;]\n    R6[\&quot;ReLU → Requant → Clip 0..127&lt;br/&gt;Đầu ra: 84 phần tử, INT8\&quot;]\n    OUTPUT[\&quot;Output: Linear 84→10 + bias&lt;br/&gt;10 logits INT32\&quot;]\n    ARGMAX[\&quot;Argmax: chọn chỉ số logit lớn nhất&lt;br/&gt;Nếu hòa, chọn chỉ số nhỏ nhất\&quot;]\n    RESULT[/\&quot;Xuất chữ số dự đoán 0..9\&quot;/]\n    FINISH([\&quot;Kết thúc\&quot;])\n\n    START --&gt; INPUT --&gt; PAD\n    PAD --&gt; C1 --&gt; R1 --&gt; S2\n    S2 --&gt; C3 --&gt; R3 --&gt; S4\n    S4 --&gt; C5 --&gt; R5 --&gt; FLAT\n    FLAT --&gt; F6 --&gt; R6 --&gt; OUTPUT\n    OUTPUT --&gt; ARGMAX --&gt; RESULT --&gt; FINISH\n\n    classDef conv fill:#dae8fc,stroke:#6c8ebf,color:#000;\n    classDef activation fill:#e1d5e7,stroke:#9673a6,color:#000;\n    classDef pool fill:#d5e8d4,stroke:#82b366,color:#000;\n    classDef linear fill:#ffe6cc,stroke:#d79b00,color:#000;\n\n    class C1,C3,C5 conv;\n    class R1,R3,R5,R6 activation;\n    class S2,S4 pool;\n    class F6,OUTPUT linear;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="O7SgDgGoa4VokF-r0qsZ-9">
